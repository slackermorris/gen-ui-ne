# Disable the supply-chain release-age cooldown for THIS repo only.
# vite-plus and its bundled deps (e.g. vitest) are published far more
# recently than the user-level ~/.npmrc `min-release-age=14` allows, so
# installs fail with ETARGET ("no matching version ... with a date before").
# Other projects keep the 14-day cooldown.
min-release-age=0
